                        }
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/200"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                }
            },
            "put": {
                "tags": ["Календари"],
                "summary": "Изменение календаря.",
                "description": "Позволяет изменить календарь. Для изменения необходимо пройти аутентификацию.",
                "parameters": [
                    {
                        "name": "calendar",
                        "description": "id календаря",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": 1,
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Изменение календаря"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/200"
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                },
                "security": [
                    {
                        "AccessToken": []
                    }
                ]
            },
            "delete": {
                "tags": ["Календари"],
                "summary": "Удаление календаря.",
                "description": "Позволяет удалить календарь.",
                "parameters": [
                    {
                        "name": "calendar",
                        "description": "id календаря",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": 1,
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/200"
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                },
                "security": [
                    {
                        "AccessToken": []
                    }
                ]
            }
        },
        "/calendars/{calendar}/events": {
            "get": {
                "tags": ["Ивенты календаря"],
                "summary": "Список ивентов, которые принадлежат календарю.",
                "description": "Вернет список ивентов, которые принадлежат календарю.",
                "parameters": [
                    {
                        "name": "calendar",
                        "description": "id календаря",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": 1,
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/200"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                }
            },
            "post": {
                "tags": ["Ивенты календаря"],
                "summary": "Создать ивент, который будет иметь связь с календарем.",
                "description": "Позволяет создать ивент, который будет иметь связь с календарем. Для создания необходимо пройти аутентификацию.",
                "parameters": [
                    {
                        "name": "calendar",
                        "description": "id календаря",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": 1,
