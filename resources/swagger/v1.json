{
    "openapi": "3.0.0",
    "info": {
        "title": "CalendarStorm API",
        "description": "Документация к API продукта CalendarStorm",
        "version": "v1"
    },
    "tags": [
        { "name": "Аутентификация / Регистрация" },
        { "name": "Пользователь" },
        { "name": "Календари пользователя" },
        { "name": "Календари" },
        { "name": "Ивенты календаря" },
        { "name": "Ивенты" }
    ],
    "servers": [
        {
            "url": "https://calendar-storm.klikvus.duckdns.org/api/v1",
            "description": "Prod"
        },
        {
            "url": "http://localhost/api/v1",
            "description": "Local dev"
        }
    ],
    "components": {
        "schemas": {
            "Аутентификация": {
                "type": "object",
                "required": ["login", "password"],
                "properties": {
                    "login": {
                        "type": "string",
                        "example": "root"
                    },
                    "password": {
                        "type": "string",
                        "example": "password"
                    }
                }
            },
            "Регистрация": {
                "type": "object",
                "required": ["login", "password"],
                "properties": {
                    "login": {
                        "type": "string",
                        "example": "root"
                    },
                    "password": {
                        "type": "string",
                        "example": "password"
                    }
                }
            },
            "Сохранение календаря": {
                "description": "Схема сохранения календаря",
                "type": "object",
                "required": ["name"],
                "properties": {
                    "active": {
                        "title": "Активность календаря",
                        "type": "boolean",
                        "example": true
                    },
                    "name": {
                        "title": "Название календаря",
                        "type": "string",
                        "example": "test"
                    }
                }
            },
            "Изменение календаря": {
                "description": "Схема сохранения календаря",
                "type": "object",
                "properties": {
                    "active": {
                        "title": "Активность календаря",
                        "type": "boolean",
                        "example": true
                    },
                    "owner_id": {
                        "title": "Id создателя календаря",
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "title": "Название календаря",
                        "type": "string",
                        "example": "test"
                    }
                }
            },
            "Сохранение ивента": {
                "description": "Схема сохранения ивента",
                "type": "object",
                "required": ["name", "color"],
                "properties": {
                    "active": {
                        "title": "Активность ивента",
                        "type": "boolean",
                        "example": true
                    },
                    "name": {
                        "title": "Название ивента",
                        "type": "string",
                        "example": "test"
                    },
                    "description": {
                        "title": "Описание ивента",
                        "type": "string",
                        "example": "test description"
                    },
                    "link": {
                        "title": "Ссылка на ивент",
                        "type": "string",
                        "example": "https://test.com"
                    },
                    "color": {
                        "title": "Цвет ивента",
                        "type": "string",
                        "example": "#fff"
                    },
                    "beginning": {
                        "title": "Дата начала ивента",
                        "description": "Формат YYYY-MM-DD HH:MM:SS",
                        "type": "dateTime",
                        "example": "2024-04-27 06:58:09"
                    },
                    "ending": {
                        "title": "Дата окончания ивента",
                        "description": "Формат YYYY-MM-DD HH:MM:SS",
                        "type": "dateTime",
                        "example": "024-04-29 16:58:09"
                    }
                }
            },
            "Изменение ивента": {
                "description": "Схема сохранения ивента",
                "type": "object",
                "properties": {
                    "active": {
                        "title": "Активность ивента",
                        "type": "boolean",
                        "example": true
                    },
                    "name": {
                        "title": "Название ивента",
                        "type": "string",
                        "example": "test"
                    },
                    "description": {
                        "title": "Описание ивента",
                        "type": "string",
                        "example": "test description"
                    },
                    "link": {
                        "title": "Ссылка на ивент",
                        "type": "string",
                        "example": "https://test.com"
                    },
                    "color": {
                        "title": "Цвет ивента",
                        "type": "string",
                        "example": "#fff"
                    },
                    "beginning": {
                        "title": "Дата начала ивента",
                        "description": "Формат YYYY-MM-DD HH:MM:SS",
                        "type": "dateTime",
                        "example": "2024-04-27 06:58:09"
                    },
                    "ending": {
                        "title": "Дата окончания ивента",
                        "description": "Формат YYYY-MM-DD HH:MM:SS",
                        "type": "dateTime",
                        "example": "024-04-29 16:58:09"
                    }
                }
            }
        },
        "responses": {
            "200": {
                "description": "Успешно.",
                "content": {
                    "application/json": {}
                }
            },
            "201": {
                "description": "Успешно создано.",
                "content": {
                    "application/json": {}
                }
            },
            "401": {
                "description": "Ошибка аунтефикации. Возникает по причине отсутсвия Bearer token или при истичении его срока жизни.",
                "content": {
                    "application/json": {}
                }
            },
            "422": {
                "description": "Ошибка при валидации переданых данных.",
                "content": {
                    "application/json": {}
                }
            }
        },
        "securitySchemes": {
            "AccessToken": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Можно получить после аутентификации и для использования нужно передать в `header` запроса. Пример: `'Authorization: Bearer TOKEN'`"
            }
        }
    },
    "paths": {
        "/auth/login": {
            "post": {
                "tags": ["Аутентификация / Регистрация"],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Аутентификация"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/200"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "tags": ["Аутентификация / Регистрация"],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Аутентификация"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "$ref": "#/components/responses/201"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                }
            }
        },
        "/user/{user}": {
            "get": {
                "tags": ["Пользователь"],
                "summary": "Информация о пользователе",
                "parameters": [
                    {
                        "name": "user",
                        "description": "id пользователя",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": 1,
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/200"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                }
            }
        },
        "/user/{user}/calendars": {
            "get": {
                "tags": ["Календари пользователя"],
                "summary": "Список всех календарей, которые были созданы пользователем.",
                "description": "Вернет список календарей, которые были созданы пользователем, чей token был передан в header. Для получения списка календарей необходимо пройти аутентификацию.",
                "parameters": [
                    {
                        "name": "user",
                        "description": "id пользователя",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": 1,
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page",
                        "description": "номер страницы",
                        "in": "query",
                        "schema": {
                            "example": 1,
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/200"
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                }
            }
        },
        "/calendars": {
            "get": {
                "tags": ["Календари"],
                "summary": "Список всех календарей.",
                "description": "Вернет список всех календарей с пагинацией.",
                "parameters": [
                    {
                        "name": "page",
                        "description": "номер страницы",
                        "in": "query",
                        "schema": {
                            "example": 1,
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/200"
                    }
                }
            },
            "post": {
                "tags": ["Календари"],
                "summary": "Создание календаря.",
                "description": "Позволяет создать календарь. Для создания необходимо пройти аутентификацию.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Сохранение календаря"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "$ref": "#/components/responses/201"
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                },
                "security": [
                    {
                        "AccessToken": []
                    }
                ]
            }
        },
